{
  "name": "@deepseek-ai/dsh-desktop-runtime",
  "description": "Standalone DeepSeek Harness runtime process for the desktop app: programmatic boot of the web profile composition without the HTTP serving rows, readiness and shutdown over fork IPC",
  "version": "0.1.1-rc.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./lib/types/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./dist/native.js"
    },
    "./directory-picker": {
      "types": "./lib/types/directory-picker.d.ts",
      "default": "./dist/directory-picker.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-agent-tool-presentation": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-persona": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "@deepseek-ai/dsh-terminal-bash": "workspace:^",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:^",
    "@deepseek-ai/dsh-tool-bash-persistent": "workspace:^",
    "@deepseek-ai/dsh-tool-cordis": "workspace:^",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^",
    "koffi": "^3.1.0"
  }
}
