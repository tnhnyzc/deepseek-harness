{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Desktop shell for DeepSeek Harness: Electron main broker, private dsh-app:// renderer protocol, thin renderer entry",
  "version": "0.1.1-rc.2",
  "private": true,
  "productName": "DeepSeek Harness Desktop",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsdown",
    "build:renderer": "vite build",
    "bundle:node": "tsx scripts/bundle-node.ts",
    "start": "electron ."
  },
  "devDependencies": {
    "@electron-forge/shared-types": "7.11.2",
    "@types/node": "^22.20.0",
    "electron": "43.4.1",
    "playwright": "^1.49.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
